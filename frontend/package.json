{
  "name": "medicore-clinic-management-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MediCore clinic management system \u2014 React frontend",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "echo 'Add eslint if required'",
    "test:client": "node tests/api-client.test.mjs",
    "test:render": "vite build --config vite.render-test.config.js && node tests/render-smoke.test.mjs",
    "test": "npm run test:client && npm run test:render && npm run test:integration",
    "start": "vite preview --host 0.0.0.0 --port 5173",
    "serve:built": "vite build && vite preview --host 0.0.0.0 --port 5173",
    "test:integration": "vite build --config vite.render-test.config.js && node tests/integration.test.mjs"
  },
  "dependencies": {
    "axios": "1.7.9",
    "clsx": "2.1.1",
    "jsqr": "1.4.0",
    "lucide-react": "0.469.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.1",
    "recharts": "2.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "vite": "6.0.7",
    "jsdom": "^25.0.1"
  }
}
